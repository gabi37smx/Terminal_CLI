{
  "version": 1,
  "almacen": {
    "ruta": "~/DAM-almacen"
  },
  "acciones": [
    {
      "nombre": "ordenar",
      "descripcion": "Ordena los ficheros por asignatura del DAM y los mete en tu almacén; lo demás, a ~/Datos/POR-TIPO (por nombre, extensión y contenido del PDF)",
      "tipo": "ordenar",
      "origen": "~/pruebas-tareas/prueba-final",
      "carpetas": {
        "bases-datos": [
          "base de dades",
          "bases de dades",
          "bases de datos",
