        ],
        "lenguaje-marcas": [
          "llenguatge de marques",
          "lenguaje de marcas",
          "marques",
          "marcas",
          "xml",
          "html",
          "json"
        ],
        "programacion": [
          "programacio ia",
          "programacio",
          "programacion",
          "python",
          "poo",
          "classe",
          "clase",
          "funcio",
          "funcion",
          "objecte",
          "objeto"
        ],
        "proyecto": [
          "projecte",
          "proyecto",
          "intermodular",
          "multiplataforma"
        ],
        "sistemas": [
          "sistemes",
          "sistemas",
          "linux",
          "xarxes",
          "redes",
          "hardware",
          "so",
          "sistemes informatics",
          "sistemas informaticos",
          "arquitectura",
          "von neumann",
          "ordinador",
          "ordinadors",
          "ordenador",
          "ordenadores",
          "computadora",
          "cpu",
          "ucp",
          "processador",
          "procesador",
          "maquinari",
          "xarxa",
          "windows"
        ]
      },
      "por_extension": {
        ".py": "programacion",
        ".sql": "bases-datos",
        ".xml": "lenguaje-marcas",
        ".html": "lenguaje-marcas",
        ".sh": "sistemas",
        ".db": "bases-datos",
        ".htm": "lenguaje-marcas"
      },
      "al_almacen": true,
      "por_tipo": "~/Datos/POR-TIPO",
      "confirmar": true
    },
    {
      "nombre": "limpiar-temporales",
      "descripcion": "Borra ficheros temporales (.tmp, .temp, .bak, .cache, .part, .swp, .download, .crdownload) con más de 30 días",
      "tipo": "borrar",
      "origen": "~/pruebas-tareas/prueba-final",
      "filtro": {
        "extensiones": [
          ".tmp",
          ".temp",
          ".bak",
          ".cache",
          ".part",
          ".swp",
          ".download",
          ".crdownload"
        ],
        "mas_antiguo_que_dias": 30
      },
      "confirmar": true
    },
    {
      "nombre": "convertir-webp",
      "descripcion": "Convierte las imágenes JPEG y PNG a WebP sin tocar el original",
      "tipo": "convertir",
      "origen": "~/pruebas-tareas/prueba-final",
      "filtro": {
        "extensiones": [
          ".jpg",
          ".jpeg",
          ".png"
        ]
      },
      "calidad": 80,
      "confirmar": true
    },
    {
      "nombre": "renombrar-capturas",
      "descripcion": "Renombra las capturas de pantalla con su fecha y un número",
      "tipo": "renombrar",
      "origen": "~/pruebas-tareas/prueba-final",
      "filtro": {
        "extensiones": [
          ".png",
          ".jpg"
        ],
        "patron": "^(Captura|Screenshot)"
      },
      "plantilla": "captura_{fecha:%Y-%m-%d}_{n:03}{ext}",
      "confirmar": true
    },
    {
      "nombre": "copiar-entregas",
      "descripcion": "Copia las entregas y prácticas a una carpeta de seguridad",
      "tipo": "copiar",
      "origen": "~/pruebas-tareas/prueba-final",
      "destino": "~/pruebas-tareas/entregas",
      "filtro": {
        "extensiones": [
          ".pdf",
          ".docx",
          ".zip"
        ],
        "patron": "(?i)entrega|practica"
      },
      "confirmar": true
    },
    {
      "nombre": "mover-zips",
      "descripcion": "Mueve los .zip de la carpeta a una subcarpeta comprimidos",
      "tipo": "mover",
      "origen": "~/pruebas-tareas/prueba-final",
      "destino": "~/pruebas-tareas/prueba-final/comprimidos",
      "filtro": {
        "extensiones": [
          ".zip"
        ]
      },
      "confirmar": true
    },
    {
      "nombre": "resumir-tema",
      "descripcion": "Resume cada tema de apuntes (PDF, TXT o MD, en castellano o valenciano) en un .md para repasar",
      "tipo": "resumir",
      "origen": "~/pruebas-tareas/apuntes-ia",
      "filtro": {
        "extensiones": [
          ".pdf",
          ".txt",
          ".md"
        ],
        "patron": "^(?!.*\\.resumen\\.md$)"
      },
      "destino": "~/pruebas-tareas/resumenes",
      "instrucciones": "Resume en castellano, aunque el apunte esté en valenciano. Como máximo 6 viñetas; pon entre `comillas invertidas` las órdenes, etiquetas o palabras clave de código. Acaba con una línea que empiece por «Para el examen:» y diga, en una frase, lo que más cuenta.",
      "max_caracteres": 12000
    },
    {
      "nombre": "nombrar-descargas",
      "descripcion": "Pone a los PDF con nombre genérico (escaneo, documento (3), descarga...) un nombre que diga de qué tratan",
      "tipo": "renombrar-ia",
      "origen": "~/pruebas-tareas/descargas-ia",
      "filtro": {
        "extensiones": [
          ".pdf",
          ".txt"
        ],
        "patron": "(?i)^(escaneo|scan|documento|document|descarga|download|unnamed|untitled|sin t[ií]tulo|file)"
      },
      "instrucciones": "Si es un tema de una asignatura de 1º de DAM, empieza por la asignatura (por ejemplo «redes-direccion-ip» o «bases-datos-consultas-sql»). Si es otra cosa (un calendario, una factura...), di lo que es.",
      "max_caracteres": 4000,
      "confirmar": true
    },
    {
      "nombre": "clasificar-asignatura",
      "descripcion": "Lee cada apunte que «ordenar» no sabe colocar y lo mueve a la carpeta de su asignatura de 1º de DAM",
      "tipo": "clasificar",
      "origen": "~/pruebas-tareas/apuntes-ia",
      "filtro": {
        "extensiones": [
          ".pdf",
          ".txt",
          ".md"
        ],
        "patron": "^(?!.*\\.resumen\\.md$)"
      },
      "categorias": [
        "bases-datos",
        "entornos",
        "ingles",
        "ipo",
        "lenguaje-marcas",
        "programacion",
        "proyecto",
        "sistemas",
        "otros"
      ],
      "destino": "~/pruebas-tareas/por-asignatura",
      "instrucciones": "Son apuntes de 1º de DAM, en castellano o en valenciano. Redes, Linux, hardware y sistemas operativos van en «sistemas»; XML, HTML y JSON en «lenguaje-marcas»; Git, IDE y Docker en «entornos». Si no es de ninguna asignatura (un calendario, una factura...), responde «otros».",
      "max_caracteres": 4000,
      "confirmar": true
    }
  ]
}
