    {
      "nombre": "limpiar-temporales",
      "descripcion": "Borra ficheros temporales (.tmp, .temp, .bak, .cache, .part, .swp, .download, .crdownload) con más de 30 días",
      "tipo": "borrar",
      "origen": "~/pruebas-tareas/prueba-final",
      "filtro": {
        "extensiones": [
          ".tmp",
          ".temp",
          ".bak",
          ".cache",
          ".part",
          ".swp",
          ".download",
          ".crdownload"
        ],
        "mas_antiguo_que_dias": 30
      },
      "confirmar": true
    },
    {
      "nombre": "convertir-webp",
      "descripcion": "Convierte las imágenes JPEG y PNG a WebP sin tocar el original",
      "tipo": "convertir",
      "origen": "~/pruebas-tareas/prueba-final",
      "filtro": {
        "extensiones": [
          ".jpg",
          ".jpeg",
          ".png"
        ]
      },
      "calidad": 80,
      "confirmar": true
    },
    {
      "nombre": "renombrar-capturas",
      "descripcion": "Renombra las capturas de pantalla con su fecha y un número",
      "tipo": "renombrar",
      "origen": "~/pruebas-tareas/prueba-final",
      "filtro": {
        "extensiones": [
          ".png",
          ".jpg"
        ],
        "patron": "^(Captura|Screenshot)"
      },
      "plantilla": "captura_{fecha:%Y-%m-%d}_{n:03}{ext}",
      "confirmar": true
    },
    {
      "nombre": "copiar-entregas",
      "descripcion": "Copia las entregas y prácticas a una carpeta de seguridad",
      "tipo": "copiar",
      "origen": "~/pruebas-tareas/prueba-final",
      "destino": "~/pruebas-tareas/entregas",
      "filtro": {
        "extensiones": [
          ".pdf",
          ".docx",
          ".zip"
        ],
        "patron": "(?i)entrega|practica"
      },
      "confirmar": true
    },
    {
      "nombre": "mover-zips",
      "descripcion": "Mueve los .zip de la carpeta a una subcarpeta comprimidos",
      "tipo": "mover",
      "origen": "~/pruebas-tareas/prueba-final",
      "destino": "~/pruebas-tareas/prueba-final/comprimidos",
      "filtro": {
        "extensiones": [
          ".zip"
        ]
      },
      "confirmar": true
    }
  ]
}
