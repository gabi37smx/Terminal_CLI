{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "webfetch": "ask",
    "external_directory": "ask",
    "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny", "*.env.example": "allow" },
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "uv run dam --help": "allow",
      "uv run dam validar": "allow",
      "uv run dam validar *": "allow",
      "uv run dam status": "allow",
      "uv run dam status *": "allow",
      "uv run pytest": "allow",
      "uv run pytest *": "allow",
      "uv run dam ejecutar *": "ask",
      "uv run dam sync": "ask",
      "uv run dam sync *": "ask",
      "git commit *": "ask",
      "git push *": "deny",
      "git reset *": "deny",
      "rm *": "deny",
      "sudo *": "deny"
    }
  },
  "agent": {
    "plan": { "permission": { "edit": "deny" } }
  }
}
