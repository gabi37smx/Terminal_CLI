{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": true
      },
      "apuntes": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "./docs"],
        "disabled": true
      }
    }
  },
  "permission": {
    "edit": "ask",
    "webfetch": "ask",
    "external_directory": "ask",
    "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny", "*.env.example": "allow" },
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "uv run mochila --help": "allow",
      "uv run mochila validar": "allow",
      "uv run mochila validar *": "allow",
      "uv run mochila status": "allow",
      "uv run mochila status *": "allow",
      "uv run pytest": "allow",
      "uv run pytest *": "allow",
      "uv run mochila ejecutar *": "ask",
      "uv run mochila sync": "ask",
      "uv run mochila sync *": "ask",
      "git commit *": "ask",
      "git push *": "deny",
      "git reset *": "deny",
      "rm *": "deny",
      "Remove-Item *": "deny",
      "ri *": "deny",
      "del *": "deny",
      "erase *": "deny",
      "rmdir *": "deny",
      "rd *": "deny",
      "git clean *": "deny",
      "sudo *": "deny"
    }
  },
  "agent": {
    "plan": { "permission": { "edit": "deny" } },
    "explore": { "permission": { "edit": "deny" } }
  }
}
